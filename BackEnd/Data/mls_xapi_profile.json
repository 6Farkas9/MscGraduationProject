{
  "profile": {
    "id": "https://legend-meta.com/xapi/profiles/metaverse-learner-service",
    "type": "xapi-profile",
    "version": "1.0.0",
    "name": {
      "en-US": "Metaverse Learner Service xAPI Profile",
      "zh-CN": "元宇宙学习者服务系统 xAPI Profile"
    },
    "description": {
      "zh-CN": "用于 video/vr/ar/interact/cooperate 五类学习单元与习题的学习者行为采集与画像分析。动词设计基于：沉浸式协作共同注意、多模态非言语协作过程、协作角色识别、认知存在阶段识别、presence 生理/行为信号分类与 serious game 学习分析/xAPI-SG profile 思路。"
    },
    "published": "2025-12-03",
    "author": {
      "name": "MLS Metaverse Learning System",
      "url": "https://legend-meta.com"
    },
    "definitions": {
      "verbs": [
        {
          "id": "https://legend-meta.com/xapi/verbs/teleported",
          "prefLabel": { "zh-CN": "传送", "en-US": "teleported" },
          "description": { "zh-CN": "学习者在 VR/AR 场景中使用传送式位移到达新位置锚点。" },
          "requirements": {
            "statementType": "teleport-event",
            "allowedActivityTypes": [
              "https://legend-meta.com/xapi/activity-types/vr",
              "https://legend-meta.com/xapi/activity-types/ar",
              "https://legend-meta.com/xapi/activity-types/interact",
              "https://legend-meta.com/xapi/activity-types/cooperate"
            ]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/verbs/navigated",
          "prefLabel": { "zh-CN": "导航移动", "en-US": "navigated" },
          "description": { "zh-CN": "学习者在 VR/AR 场景中进行连续移动（非传送），可由位姿轨迹低频采样汇总得到。" },
          "requirements": {
            "statementType": "navigation-event",
            "allowedActivityTypes": [
              "https://legend-meta.com/xapi/activity-types/vr",
              "https://legend-meta.com/xapi/activity-types/ar",
              "https://legend-meta.com/xapi/activity-types/interact",
              "https://legend-meta.com/xapi/activity-types/cooperate"
            ]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/verbs/manipulated",
          "prefLabel": { "zh-CN": "操控对象", "en-US": "manipulated" },
          "description": { "zh-CN": "学习者对虚拟对象执行抓取/移动/旋转/缩放等具身交互操作。" },
          "requirements": {
            "statementType": "object-manipulation",
            "allowedActivityTypes": [
              "https://legend-meta.com/xapi/activity-types/vr",
              "https://legend-meta.com/xapi/activity-types/ar",
              "https://legend-meta.com/xapi/activity-types/interact",
              "https://legend-meta.com/xapi/activity-types/cooperate"
            ]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/verbs/configured",
          "prefLabel": { "zh-CN": "配置参数", "en-US": "configured" },
          "description": { "zh-CN": "学习者对实验/仿真/系统参数进行设置或调整（如难度、实验变量、设备参数等）。" },
          "requirements": {
            "statementType": "parameter-configuration",
            "allowedActivityTypes": [
              "https://legend-meta.com/xapi/activity-types/interact",
              "https://legend-meta.com/xapi/activity-types/vr",
              "https://legend-meta.com/xapi/activity-types/ar"
            ]
          }
        },

        {
          "id": "https://legend-meta.com/xapi/verbs/fixated",
          "prefLabel": { "zh-CN": "注视停留", "en-US": "fixated" },
          "description": { "zh-CN": "学习者对某对象/资源/区域发生注视停留（眼动 fixation，或头朝向射线近似）。" },
          "requirements": {
            "statementType": "attention-event",
            "allowedActivityTypes": [
              "https://legend-meta.com/xapi/activity-types/vr",
              "https://legend-meta.com/xapi/activity-types/ar",
              "https://legend-meta.com/xapi/activity-types/interact",
              "https://legend-meta.com/xapi/activity-types/cooperate"
            ]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/verbs/jointly-attended",
          "prefLabel": { "zh-CN": "共同注意", "en-US": "jointly-attended" },
          "description": { "zh-CN": "两个或多个学习者在时间窗内对同一对象/资源形成共同注意（基于 gaze/头朝向射线重叠判断）。" },
          "requirements": {
            "statementType": "joint-attention-event",
            "allowedActivityTypes": [
              "https://legend-meta.com/xapi/activity-types/cooperate",
              "https://legend-meta.com/xapi/activity-types/vr",
              "https://legend-meta.com/xapi/activity-types/ar"
            ]
          }
        },

        {
          "id": "https://legend-meta.com/xapi/verbs/referred",
          "prefLabel": { "zh-CN": "指示/指向", "en-US": "referred" },
          "description": { "zh-CN": "学习者通过手势/凝视/话语对对象或资源进行指示，引导协作伙伴关注。" },
          "requirements": {
            "statementType": "collab-nonverbal-event",
            "allowedActivityTypes": ["https://legend-meta.com/xapi/activity-types/cooperate"]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/verbs/followed",
          "prefLabel": { "zh-CN": "跟随指示", "en-US": "followed" },
          "description": { "zh-CN": "学习者在时间窗内跟随他人指示，将注意/注视转移到指向目标。" },
          "requirements": {
            "statementType": "collab-nonverbal-event",
            "allowedActivityTypes": ["https://legend-meta.com/xapi/activity-types/cooperate"]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/verbs/managed-resource",
          "prefLabel": { "zh-CN": "资源管理", "en-US": "managed-resource" },
          "description": { "zh-CN": "学习者在协作中打开/切换/共享/置顶/整理共享资源（白板、面板、资料等）。" },
          "requirements": {
            "statementType": "collab-resource-event",
            "allowedActivityTypes": ["https://legend-meta.com/xapi/activity-types/cooperate"]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/verbs/took-turn",
          "prefLabel": { "zh-CN": "完成话轮", "en-US": "took-turn" },
          "description": { "zh-CN": "学习者完成一次发言话轮（可由 VAD/diarization 在端侧或轻量推理得到）。" },
          "requirements": {
            "statementType": "speech-turn-event",
            "allowedActivityTypes": ["https://legend-meta.com/xapi/activity-types/cooperate"]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/verbs/responded",
          "prefLabel": { "zh-CN": "响应", "en-US": "responded" },
          "description": { "zh-CN": "学习者对他人发言/动作作出响应（回复话轮或执行跟随/资源管理等可观测响应）。" },
          "requirements": {
            "statementType": "collab-response-event",
            "allowedActivityTypes": ["https://legend-meta.com/xapi/activity-types/cooperate"]
          }
        },

        {
          "id": "https://legend-meta.com/xapi/verbs/attempted",
          "prefLabel": { "zh-CN": "尝试", "en-US": "attempted" },
          "description": { "zh-CN": "学习者尝试执行某步骤/关卡/实验动作（强交互/游戏化/实验性单元）。" },
          "requirements": {
            "statementType": "task-attempt",
            "allowedActivityTypes": ["https://legend-meta.com/xapi/activity-types/interact"]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/verbs/succeeded",
          "prefLabel": { "zh-CN": "成功", "en-US": "succeeded" },
          "description": { "zh-CN": "学习者完成交互任务/步骤并成功达成系统判定条件。" },
          "requirements": {
            "statementType": "task-outcome",
            "allowedActivityTypes": ["https://legend-meta.com/xapi/activity-types/interact"]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/verbs/failed-action",
          "prefLabel": { "zh-CN": "动作失败", "en-US": "failed-action" },
          "description": { "zh-CN": "学习者在动作级交互中失败（非法步骤、碰撞错误、参数越界等），区别于整题 failed。" },
          "requirements": {
            "statementType": "task-outcome",
            "allowedActivityTypes": ["https://legend-meta.com/xapi/activity-types/interact"]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/verbs/collected",
          "prefLabel": { "zh-CN": "收集", "en-US": "collected" },
          "description": { "zh-CN": "学习者收集/拾取关键物品、线索或数据点（常见于探究式与游戏化）。" },
          "requirements": {
            "statementType": "collection-event",
            "allowedActivityTypes": ["https://legend-meta.com/xapi/activity-types/interact"]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/verbs/used-tool",
          "prefLabel": { "zh-CN": "使用工具", "en-US": "used-tool" },
          "description": { "zh-CN": "学习者使用虚拟工具/仪器（测量、探针、焊接、显微等）。" },
          "requirements": {
            "statementType": "tool-usage-event",
            "allowedActivityTypes": ["https://legend-meta.com/xapi/activity-types/interact"]
          }
        },

        {
          "id": "https://legend-meta.com/xapi/verbs/measured-physio",
          "prefLabel": { "zh-CN": "采集生理/行为信号", "en-US": "measured-physio" },
          "description": { "zh-CN": "学习者设备侧记录一次生理或行为信号测量（如心率、皮电、头动强度、动作速率、错误率等），用于presence/负荷等状态推断。" },
          "requirements": {
            "statementType": "physio-measurement",
            "allowedActivityTypes": [
              "https://legend-meta.com/xapi/activity-types/vr",
              "https://legend-meta.com/xapi/activity-types/ar",
              "https://legend-meta.com/xapi/activity-types/interact",
              "https://legend-meta.com/xapi/activity-types/cooperate"
            ]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/verbs/classified-presence",
          "prefLabel": { "zh-CN": "判定临场感等级", "en-US": "classified-presence" },
          "description": { "zh-CN": "系统对一段时间窗内数据进行轻量推理/模型推理，输出presence等级或连续分数，用于自适应服务。" },
          "requirements": {
            "statementType": "presence-classification",
            "allowedActivityTypes": [
              "https://legend-meta.com/xapi/activity-types/vr",
              "https://legend-meta.com/xapi/activity-types/ar",
              "https://legend-meta.com/xapi/activity-types/interact",
              "https://legend-meta.com/xapi/activity-types/cooperate"
            ]
          }
        },

        {
          "id": "https://legend-meta.com/xapi/verbs/questioned",
          "prefLabel": { "zh-CN": "提出问题(触发)", "en-US": "questioned" },
          "description": { "zh-CN": "讨论文本被识别为认知存在 Triggering Events：提出问题/困惑/触发议题。" },
          "requirements": {
            "statementType": "cognitive-presence-post",
            "allowedActivityTypes": [
              "https://legend-meta.com/xapi/activity-types/quiz",
              "https://legend-meta.com/xapi/activity-types/cooperate"
            ]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/verbs/explored",
          "prefLabel": { "zh-CN": "探索讨论", "en-US": "explored" },
          "description": { "zh-CN": "讨论文本被识别为认知存在 Exploration：信息搜寻/观点交换/发散探讨。" },
          "requirements": {
            "statementType": "cognitive-presence-post",
            "allowedActivityTypes": [
              "https://legend-meta.com/xapi/activity-types/quiz",
              "https://legend-meta.com/xapi/activity-types/cooperate"
            ]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/verbs/integrated",
          "prefLabel": { "zh-CN": "整合观点", "en-US": "integrated" },
          "description": { "zh-CN": "讨论文本被识别为认知存在 Integration：整合多观点形成解释/方案。" },
          "requirements": {
            "statementType": "cognitive-presence-post",
            "allowedActivityTypes": [
              "https://legend-meta.com/xapi/activity-types/quiz",
              "https://legend-meta.com/xapi/activity-types/cooperate"
            ]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/verbs/resolved",
          "prefLabel": { "zh-CN": "解决/应用", "en-US": "resolved" },
          "description": { "zh-CN": "讨论文本被识别为认知存在 Resolution：评估方案并解决问题/应用新知识。" },
          "requirements": {
            "statementType": "cognitive-presence-post",
            "allowedActivityTypes": [
              "https://legend-meta.com/xapi/activity-types/quiz",
              "https://legend-meta.com/xapi/activity-types/cooperate"
            ]
          }
        }
      ],

      "activityTypes": [
        {
          "id": "https://legend-meta.com/xapi/activity-types/video",
          "name": { "zh-CN": "视频学习单元", "en-US": "video unit" }
        },
        {
          "id": "https://legend-meta.com/xapi/activity-types/vr",
          "name": { "zh-CN": "VR学习单元", "en-US": "VR unit" }
        },
        {
          "id": "https://legend-meta.com/xapi/activity-types/ar",
          "name": { "zh-CN": "AR学习单元", "en-US": "AR unit" }
        },
        {
          "id": "https://legend-meta.com/xapi/activity-types/interact",
          "name": { "zh-CN": "强交互学习单元", "en-US": "interactive unit" }
        },
        {
          "id": "https://legend-meta.com/xapi/activity-types/cooperate",
          "name": { "zh-CN": "协作学习单元", "en-US": "cooperative unit" }
        },
        {
          "id": "https://legend-meta.com/xapi/activity-types/quiz",
          "name": { "zh-CN": "习题/测验", "en-US": "quiz" }
        },
        {
          "id": "https://legend-meta.com/xapi/activity-types/scene-object",
          "name": { "zh-CN": "场景对象", "en-US": "scene object" }
        },
        {
          "id": "https://legend-meta.com/xapi/activity-types/shared-resource",
          "name": { "zh-CN": "共享资源", "en-US": "shared resource" }
        },
        {
          "id": "https://legend-meta.com/xapi/activity-types/discussion-post",
          "name": { "zh-CN": "讨论发言", "en-US": "discussion post" }
        }
      ],

      "extensionKeys": [
        {
          "id": "https://legend-meta.com/xapi/ext/unitType",
          "valueType": "string",
          "allowedValues": ["video", "vr", "ar", "interact", "cooperate", "quiz"],
          "requiredIn": ["context"],
          "description": { "zh-CN": "学习单元类别，用于统一过滤与统计。" }
        },
        {
          "id": "https://legend-meta.com/xapi/ext/sessionId",
          "valueType": "string",
          "requiredIn": ["context"],
          "description": { "zh-CN": "一次学习会话/房间会话的唯一标识（推荐与 context.registration 对齐或映射）。" }
        },
        {
          "id": "https://legend-meta.com/xapi/ext/device",
          "valueType": "object",
          "requiredIn": ["context"],
          "description": { "zh-CN": "端侧设备信息（HMD型号、控制器、OS、版本等）。" },
          "schema": {
            "type": "object",
            "properties": {
              "hmd": { "type": "string" },
              "os": { "type": "string" },
              "appVersion": { "type": "string" },
              "input": { "type": "string", "enum": ["controller", "handTracking", "mixed"] }
            },
            "required": ["hmd", "appVersion"]
          }
        },

        {
          "id": "https://legend-meta.com/xapi/ext/poseFrom",
          "valueType": "object",
          "requiredIn": ["context"],
          "description": { "zh-CN": "位移/传送起点位姿（可简化只存 position）。" },
          "schema": {
            "type": "object",
            "properties": {
              "position": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
              "rotation": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
            },
            "required": ["position"]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/ext/poseTo",
          "valueType": "object",
          "requiredIn": ["context"],
          "description": { "zh-CN": "位移/传送终点位姿（可简化只存 position）。" },
          "schema": {
            "type": "object",
            "properties": {
              "position": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
              "rotation": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
            },
            "required": ["position"]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/ext/navSummary",
          "valueType": "object",
          "requiredIn": ["result"],
          "description": { "zh-CN": "连续移动摘要（时间窗/距离/平均速度等），用于轻量化记录代替全轨迹上传。" },
          "schema": {
            "type": "object",
            "properties": {
              "windowSeconds": { "type": "number", "minimum": 0 },
              "distanceMeters": { "type": "number", "minimum": 0 },
              "avgSpeedMps": { "type": "number", "minimum": 0 }
            },
            "required": ["windowSeconds", "distanceMeters"]
          }
        },

        {
          "id": "https://legend-meta.com/xapi/ext/manipulationType",
          "valueType": "string",
          "requiredIn": ["result"],
          "allowedValues": ["grab", "move", "rotate", "scale", "release", "press", "drag"],
          "description": { "zh-CN": "操控动作类型。" }
        },
        {
          "id": "https://legend-meta.com/xapi/ext/targetObjectType",
          "valueType": "string",
          "requiredIn": ["context"],
          "allowedValues": ["scene-object", "shared-resource", "tool", "ui", "avatar"],
          "description": { "zh-CN": "被作用对象类别（场景物体/共享资源/工具/UI/虚拟人等）。" }
        },

        {
          "id": "https://legend-meta.com/xapi/ext/gazeMethod",
          "valueType": "string",
          "requiredIn": ["context"],
          "allowedValues": ["eyeTracking", "headRaycast"],
          "description": { "zh-CN": "注视数据来源：眼动或头朝向射线近似。" }
        },
        {
          "id": "https://legend-meta.com/xapi/ext/fixationMs",
          "valueType": "number",
          "requiredIn": ["result"],
          "description": { "zh-CN": "注视停留时长（毫秒）。" }
        },
        {
          "id": "https://legend-meta.com/xapi/ext/participants",
          "valueType": "array",
          "requiredIn": ["context"],
          "description": { "zh-CN": "参与共同注意/协作事件的学习者ID列表（最少2人）。" },
          "schema": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2
          }
        },
        {
          "id": "https://legend-meta.com/xapi/ext/attentionWindowMs",
          "valueType": "number",
          "requiredIn": ["context"],
          "description": { "zh-CN": "共同注意判断的时间窗大小（毫秒）。" }
        },

        {
          "id": "https://legend-meta.com/xapi/ext/modality",
          "valueType": "string",
          "requiredIn": ["context"],
          "allowedValues": ["gesture", "gaze", "speech", "mixed"],
          "description": { "zh-CN": "协作非言语/言语行为主要模态来源。" }
        },
        {
          "id": "https://legend-meta.com/xapi/ext/resourceAction",
          "valueType": "string",
          "requiredIn": ["result"],
          "allowedValues": ["open", "close", "switch", "share", "pin", "unpin", "annotate", "rearrange"],
          "description": { "zh-CN": "资源管理的具体动作。" }
        },

        {
          "id": "https://legend-meta.com/xapi/ext/turnMs",
          "valueType": "number",
          "requiredIn": ["result"],
          "description": { "zh-CN": "话轮时长（毫秒）。" }
        },
        {
          "id": "https://legend-meta.com/xapi/ext/responseTo",
          "valueType": "object",
          "requiredIn": ["context"],
          "description": { "zh-CN": "响应对象（可指向对方的statementId或发言ID或动作事件ID）。" },
          "schema": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["statement", "utterance", "action"] },
              "id": { "type": "string" }
            },
            "required": ["type", "id"]
          }
        },

        {
          "id": "https://legend-meta.com/xapi/ext/taskId",
          "valueType": "string",
          "requiredIn": ["context"],
          "description": { "zh-CN": "interact单元中的任务/步骤/关卡标识。" }
        },
        {
          "id": "https://legend-meta.com/xapi/ext/attemptIndex",
          "valueType": "number",
          "requiredIn": ["result"],
          "description": { "zh-CN": "同一 taskId 的第几次尝试（从1开始）。" }
        },
        {
          "id": "https://legend-meta.com/xapi/ext/failureType",
          "valueType": "string",
          "requiredIn": ["result"],
          "allowedValues": ["collision", "illegalStep", "outOfRange", "timeout", "wrongTarget", "unknown"],
          "description": { "zh-CN": "动作失败类型（用于错误画像）。" }
        },
        {
          "id": "https://legend-meta.com/xapi/ext/toolId",
          "valueType": "string",
          "requiredIn": ["context"],
          "description": { "zh-CN": "虚拟工具标识（used-tool动词）。" }
        },

        {
          "id": "https://legend-meta.com/xapi/ext/physio",
          "valueType": "object",
          "requiredIn": ["result"],
