          "requirements": {
            "statementType": "item-response",
            "allowedActivityTypes": ["https://legend-meta.com/xapi/activity-types/item"]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/verbs/skipped-item",
          "prefLabel": { "zh-CN": "跳过题目", "en-US": "skipped item" },
          "description": { "zh-CN": "学习者在未形成有效作答的情况下跳过/放弃题目。" },
          "requirements": {
            "statementType": "item-skip",
            "allowedActivityTypes": ["https://legend-meta.com/xapi/activity-types/item"]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/verbs/reviewed-item",
          "prefLabel": { "zh-CN": "回顾题目", "en-US": "reviewed item" },
          "description": { "zh-CN": "学习者回到已做过的题目进行复查/查看解析/回看步骤。" },
          "requirements": {
            "statementType": "item-review",
            "allowedActivityTypes": ["https://legend-meta.com/xapi/activity-types/item"]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/verbs/requested-hint",
          "prefLabel": { "zh-CN": "请求提示", "en-US": "requested hint" },
          "description": { "zh-CN": "学习者在做题过程中请求提示/线索（包含分步提示）。" },
          "requirements": {
            "statementType": "item-hint",
            "allowedActivityTypes": ["https://legend-meta.com/xapi/activity-types/item"]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/verbs/viewed-explanation",
          "prefLabel": { "zh-CN": "查看解析", "en-US": "viewed explanation" },
          "description": { "zh-CN": "学习者查看题目解析/标准答案/讲解内容。" },
          "requirements": {
            "statementType": "item-explanation",
            "allowedActivityTypes": ["https://legend-meta.com/xapi/activity-types/item"]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/verbs/passed-item",
          "prefLabel": { "zh-CN": "题目通过", "en-US": "passed item" },
          "description": { "zh-CN": "学习者在题目层面达到通过标准（如得分>=阈值或关键点全对）。" },
          "requirements": {
            "statementType": "item-outcome",
            "allowedActivityTypes": ["https://legend-meta.com/xapi/activity-types/item"]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/verbs/failed-item",
          "prefLabel": { "zh-CN": "题目未通过", "en-US": "failed item" },
          "description": { "zh-CN": "学习者在题目层面未达到通过标准（如得分<阈值或关键点错误）。" },
          "requirements": {
            "statementType": "item-outcome",
            "allowedActivityTypes": ["https://legend-meta.com/xapi/activity-types/item"]
          }
        }
      ],
      "extensionKeys": [
        {
          "id": "https://legend-meta.com/xapi/ext/itemId",
          "valueType": "string",
          "requiredIn": ["context"],
          "description": { "zh-CN": "题目唯一标识（若object.id已指向题目Activity，可不重复）。" }
        },
        {
          "id": "https://legend-meta.com/xapi/ext/itemType",
          "valueType": "string",
          "requiredIn": ["context"],
          "allowedValues": ["singleChoice", "multiChoice", "fillBlank", "shortAnswer", "matching", "ordering", "coding", "simulation"],
          "description": { "zh-CN": "题型，用于题目画像与策略分析。" }
        },
        {
          "id": "https://legend-meta.com/xapi/ext/responseMode",
          "valueType": "string",
          "requiredIn": ["context"],
          "allowedValues": ["final", "draft", "autoSave", "step"],
          "description": { "zh-CN": "提交模式：最终提交/草稿/自动保存/分步提交。" }
        },
        {
          "id": "https://legend-meta.com/xapi/ext/responseSummary",
          "valueType": "object",
          "requiredIn": ["result"],
          "description": { "zh-CN": "答题摘要（建议存摘要而非原始答案；原始答案可在隐私允许下存服务器并用引用ID）。" },
          "schema": {
            "type": "object",
            "properties": {
              "isCorrect": { "type": "boolean" },
              "score": { "type": "number", "minimum": 0 },
              "maxScore": { "type": "number", "minimum": 0 },
              "attemptIndex": { "type": "number", "minimum": 1 },
              "timeOnItemSeconds": { "type": "number", "minimum": 0 }
            },
            "required": ["attemptIndex", "timeOnItemSeconds"]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/ext/hint",
          "valueType": "object",
          "requiredIn": ["context"],
          "description": { "zh-CN": "提示请求信息（第几条提示、提示级别等）。" },
          "schema": {
            "type": "object",
            "properties": {
              "hintIndex": { "type": "number", "minimum": 1 },
              "hintLevel": { "type": "string", "enum": ["light", "medium", "strong"] }
            },
            "required": ["hintIndex"]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/ext/explanation",
          "valueType": "object",
          "requiredIn": ["context"],
          "description": { "zh-CN": "解析查看信息（解析类型、是否看完等）。" },
          "schema": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["text", "video", "vr", "ar", "interactive"] },
              "completed": { "type": "boolean" }
            },
            "required": ["type"]
          }
        }
      ],
      "statementTemplates": [
        {
          "id": "https://legend-meta.com/xapi/templates/item-attempt",
          "name": { "zh-CN": "题目尝试事件", "en-US": "item attempt" },
          "verb": "https://legend-meta.com/xapi/verbs/attempted-item",
          "objectTypeRequirement": { "objectType": "Activity" },
          "required": {
            "object": ["definition.type"],
            "context": [
              "extensions.https://legend-meta.com/xapi/ext/sessionId",
              "extensions.https://legend-meta.com/xapi/ext/unitType",
              "extensions.https://legend-meta.com/xapi/ext/itemType"
            ]
          },
          "notes": {
            "zh-CN": "unitType 在题目场景中建议填写 'quiz' 或你系统内部的 'item'；object.id 必须指向题目Activity（activity-types/item）。"
          }
        },
        {
          "id": "https://legend-meta.com/xapi/templates/item-response",
          "name": { "zh-CN": "题目提交作答事件", "en-US": "item response" },
          "verb": "https://legend-meta.com/xapi/verbs/answered-item",
          "objectTypeRequirement": { "objectType": "Activity" },
          "required": {
            "context": [
              "extensions.https://legend-meta.com/xapi/ext/sessionId",
              "extensions.https://legend-meta.com/xapi/ext/unitType",
              "extensions.https://legend-meta.com/xapi/ext/itemType",
              "extensions.https://legend-meta.com/xapi/ext/responseMode"
            ],
            "result": ["extensions.https://legend-meta.com/xapi/ext/responseSummary"]
          },
          "optional": { "result": ["score", "success", "duration"] },
          "notes": {
            "zh-CN": "responseSummary 建议不放明文答案；如需可追溯，存一个服务器responseId到context扩展字段。"
          }
        },
        {
          "id": "https://legend-meta.com/xapi/templates/item-outcome",
          "name": { "zh-CN": "题目通过/未通过事件", "en-US": "item outcome" },
          "verb": "https://legend-meta.com/xapi/verbs/passed-item",
          "objectTypeRequirement": { "objectType": "Activity" },
          "required": {
            "context": ["extensions.https://legend-meta.com/xapi/ext/sessionId", "extensions.https://legend-meta.com/xapi/ext/unitType"],
            "result": ["extensions.https://legend-meta.com/xapi/ext/responseSummary"]
          },
          "notes": {
            "zh-CN": "passed-item/failed-item 使用同一模板；建议同时设置 result.success=true/false。"
          }
        },
        {
          "id": "https://legend-meta.com/xapi/templates/item-skip",
          "name": { "zh-CN": "题目跳过事件", "en-US": "item skip" },
          "verb": "https://legend-meta.com/xapi/verbs/skipped-item",
          "objectTypeRequirement": { "objectType": "Activity" },
          "required": {
            "context": ["extensions.https://legend-meta.com/xapi/ext/sessionId", "extensions.https://legend-meta.com/xapi/ext/unitType", "extensions.https://legend-meta.com/xapi/ext/itemType"]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/templates/item-review",
          "name": { "zh-CN": "题目回顾事件", "en-US": "item review" },
