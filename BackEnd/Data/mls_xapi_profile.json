    "globalStatementRequirements": {
      "actor": {
        "objectType": "Agent",
        "required": ["account.homePage", "account.name"],
        "constraints": {
          "account.homePage": "https://legend-meta.com",
          "account.name": "不得使用明文手机号/邮箱；建议为系统内部 learnerId 或脱敏标识。"
        }
      },
      "verb": {
        "required": ["id", "display"],
        "constraints": {
          "id": "必须使用本profile定义的 verb.id（https://legend-meta.com/xapi/verbs/...）。"
        }
      },
      "object": {
        "required": ["objectType", "id", "definition.type"],
        "constraints": {
          "objectType": "必须为 Activity（本profile不使用 Agent/Group 作为 object）。",
          "definition.type": "必须为本profile定义的 activityTypes 之一。"
        }
      },
      "context": {
        "required": ["extensions.https://legend-meta.com/xapi/ext/sessionId", "extensions.https://legend-meta.com/xapi/ext/unitType"],
        "recommended": ["registration", "platform", "extensions.https://legend-meta.com/xapi/ext/device"]
      },
      "result": {
        "recommended": ["duration", "success", "completion"],
        "constraints": {
          "extensions": "扩展字段必须使用本profile定义的 extensionKeys（或在后续版本中新增并登记）。"
        }
      },
      "privacyAndEdgeCollection": {
        "guidance": [
          "尽量使用端侧事件与轻量统计摘要（如navSummary）替代高频原始轨迹上传。",
          "生理/行为数据建议使用窗口汇总（windowSeconds），并明确模型来源与置信度（presence/model/confidence）。",
          "协作事件中 participants 仅记录系统内匿名ID，避免含个人敏感信息。"
        ]
      }
    }
  },
  "patch": {
    "add": {
      "activityTypes": [
        {
          "id": "https://legend-meta.com/xapi/activity-types/item",
          "name": { "zh-CN": "题目/试题条目", "en-US": "assessment item" }
        }
      ],
      "verbs": [
        {
          "id": "https://legend-meta.com/xapi/verbs/attempted-item",
          "prefLabel": { "zh-CN": "尝试作题", "en-US": "attempted item" },
          "description": { "zh-CN": "学习者开始尝试回答某一道题（进入题目、开始输入或首次作答动作）。" },
          "requirements": {
            "statementType": "item-attempt",
            "allowedActivityTypes": ["https://legend-meta.com/xapi/activity-types/item"]
          }
        },
        {
          "id": "https://legend-meta.com/xapi/verbs/answered-item",
