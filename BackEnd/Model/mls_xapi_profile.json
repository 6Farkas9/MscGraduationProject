    {
      "id": "https://example.org/xapi/verbs/started-unit",
      "type": "Verb",
      "inScheme": "https://example.org/xapi/profiles/mls-metaverse-learning",
      "prefLabel": {
        "en-US": "started unit",
        "zh-CN": "开始学习单元"
      },
      "definition": {
        "en-US": "Indicates that the learner has started a learning unit of any type (video, VR, AR, interactive, cooperative, or unknown)."
      },
      "usage": {
        "actor": {
          "objectType": "Agent",
          "account": {
            "homePage": {
              "type": "string",
              "description": "Base URI of the MLS system, e.g., https://example.org/mls"
            },
            "name": {
              "type": "string",
              "description": "Learner unique identifier (lrn_uid)."
            }
          }
        },
        "verb": {
          "id": "https://example.org/xapi/verbs/started-unit",
          "display": {
            "en-US": "started unit"
          }
        },
        "object": {
          "objectType": "Activity",
          "idPattern": "https://example.org/mls/{unit_type}/{unt_uid}",
          "definition": {
            "type": {
              "type": "string",
              "description": "Activity type IRI such as https://example.org/mls/types/video, /vr, /ar, /interact, /cooperate, or /unknown."
            }
          }
        },
        "result": {
          "type": "object",
          "description": "Usually empty for started-unit.",
          "properties": {}
        },
        "context": {
          "contextActivities": {
            "parent": {
              "idPattern": "https://example.org/mls/course/{course_id}",
              "required": false
            }
          },
          "extensions": {}
        }
      }
    },
